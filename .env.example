# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3100,http://acme.localhost:3100,http://acme-estudio.localhost:3100,http://electrica.localhost:3100,http://admin.localhost:3100

# Database (matches docker-compose.yml)
DATABASE_URL=postgres://webbuilder:webbuilder@localhost:5433/web_builder

# SMTP (Contact module) — Mailpit local (docker-compose.yml, UI en http://localhost:8025).
# El destinatario real sale del `contactEmail` de cada tenant (GlobalSettings);
# CONTACT_EMAIL_TO es solo el respaldo cuando un tenant no lo tiene configurado.
# Si 1025/8025 están ocupados en tu máquina, define MAILPIT_SMTP_PORT y
# MAILPIT_UI_PORT y ajusta SMTP_PORT para que calce.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL_FROM=no-reply@webbuilder.local
CONTACT_EMAIL_TO=contacto@example.com

# File storage (FileStorage module)
# minio en desarrollo (docker-compose.yml) | r2 en producción (Cloudflare R2)
# El bucket es privado en los dos: no hay URL pública. La API firma
# (presigned) cada URL de lectura al vuelo desde STORAGE_ENDPOINT — en R2 ese
# endpoint es el S3 API (`https://<account_id>.r2.cloudflarestorage.com`), NO
# el dominio público custom/`pub-*.r2.dev` (ese es para objetos públicos, que
# aquí no se usan).
# Si 9000/9001 están ocupados en tu máquina, define MINIO_PORT y
# MINIO_CONSOLE_PORT y ajusta STORAGE_ENDPOINT para que calce.
STORAGE_DRIVER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=web-builder-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
MAX_FILE_SIZE_MB=5

# Panel de administración (módulo Auth): usuarios reales (AdminUser), no un
# password compartido. AUTH_JWT_SECRET firma los tokens de sesión — génera
# uno propio (ej. `openssl rand -hex 32`), nunca reutilices el de otro entorno.
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_HOURS=168
# El seeder crea (o actualiza la contraseña de) este usuario si no existe —
# es tu primer login; cámbialo después desde el panel.
# Base de los enlaces de recuperación de contraseña que se mandan por correo.
ADMIN_PANEL_URL=http://localhost:3000/admin

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Revalidación de la caché del sitio publicado (SPEC 0.2). Tras cada escritura
# de administración (o de un agente), la API le avisa al frontend qué dominios
# invalidar para que el cambio se vea de inmediato.
#
# WEBAPP_REVALIDATE_URL apunta al frontend por la red interna, SIN pasar por
# Caddy: entrando por Caddy, `/api/*` lo atiende esta misma API.
# Vacía = invalidación apagada (la API funciona igual, los cambios tardan lo
# que dure la caché). REVALIDATE_SECRET tiene que ser EL MISMO valor que en
# web-builder-webapp/.env.local.
WEBAPP_REVALIDATE_URL=http://localhost:3100/api/revalidate
REVALIDATE_SECRET=

# Catálogo de bloques, variantes y estilos para el MCP (SPEC 10.5). Vive en el
# frontend, donde están los componentes: es lo que hace que agregar un bloque
# quede disponible para los agentes sin tocar la API. Vacía = el catálogo sale
# con la lista de bloques vacía y la marca `unavailable`.
WEBAPP_CATALOG_URL=http://localhost:3100/api/catalog

# Solo para correr el servidor MCP local (pnpm mcp). No los necesita la API.
WEB_BUILDER_API_URL=http://localhost:4000
WEB_BUILDER_API_KEY=

# Dominio de la plataforma: sus subdominios se dan por verificados solos.
PLATFORM_DOMAIN=localhost
# A dónde tiene que apuntar el DNS del dominio propio de un cliente.
PLATFORM_SITE_TARGET=sitios.webbuilder.co
