# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database (matches docker-compose.yml)
DATABASE_URL=postgres://webbuilder:webbuilder@localhost:5433/web_builder

# SMTP (Contact module)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL_FROM=no-reply@example.com
CONTACT_EMAIL_TO=contacto@example.com
