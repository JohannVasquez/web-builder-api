generator client {
  provider     = "prisma-client"
  output       = "../src/shared/infrastructure/prisma/generated"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  slug               String                 @unique @db.VarChar(100)
  name               String                 @db.VarChar(255)
  /// `active` sirve el sitio; `paused` y `building` responden mantención; `demo` es el sitio
  /// privado de un prospecto (ver `Demo`): solo se ve con su enlace.
  status             String                 @default("active") @db.VarChar(20)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  domains            TenantDomain[]
  pages              Page[]
  navigationLinks    NavigationLink[]
  globalSettings     GlobalSetting[]
  brand              TenantBrand?
  apiKeyScopes       ApiKeyTenant[]
  activityLogs       ActivityLog[]
  contactMessages    ContactMessage[]
  subscribers        NewsletterSubscriber[]
  storageAssets      StorageAsset[]
  blogPosts          BlogPost[]
  products           Product[]
  productCategories  ProductCategory[]
  storeSettings      StoreSettings?
  coupons            Coupon[]
  orders             Order[]
  adminUsers         AdminUserTenant[]
  idempotencyKeys    IdempotencyKey[]
  dataRightsRequests DataRightsRequest[]
  consumerClaims     ConsumerClaim[]
  redirects          Redirect[]
  consents           ConsentRecord[]
  signedDocuments    SignedDocument[]
  previewLinks       PreviewLink[]
  subscription       Subscription?
  demo               Demo?

  @@map("tenants")
}

/// Dominios por los que se llega a un tenant. Es una tabla aparte (y no una
/// columna en `tenants`) porque un cliente puede tener a la vez el subdominio
/// de la plataforma (`acme.webbuilder.co`) y su propio dominio (`acme.cl`).
///
/// - `isPrimary` marca el dominio canónico: el que se usa para construir URLs
///   absolutas (sitemap, og:url, redirects), sin importar por cuál entró el
///   visitante. Se espera exactamente uno por tenant.
/// - `verifiedAt` es nulo hasta comprobar que el cliente controla el dominio
///   (registro TXT / CNAME). Un dominio sin verificar existe en la BD pero no
///   resuelve tráfico, para que nadie reclame un dominio ajeno.
model TenantDomain {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  domain     String    @unique @db.VarChar(255)
  isPrimary  Boolean   @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

model Page {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  slug             String    @db.VarChar(255)
  title            String    @db.VarChar(255)
  description      String?
  isPublished      Boolean   @default(true) @map("is_published")
  /// Título y descripción para buscadores; nulos = se usan `title` y `description`.
  seoTitle         String?   @map("seo_title") @db.VarChar(255)
  seoDescription   String?   @map("seo_description")
  /// `key` del bucket privado para compartir en redes; misma regla que el blog.
  ogImageKey       String?   @map("og_image_key") @db.VarChar(500)
  /// Publicada pero fuera del índice: el enlace funciona, el buscador no la lista.
  noindex          Boolean   @default(false)
  /// Estilo visual propio de esta página; nulo = hereda el del sitio.
  visualStyle      String?   @map("visual_style") @db.VarChar(50)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  /// Lo que ve el público. Nulo = nunca se publicó. Las filas de `sections` son el
  /// borrador: editarlas no cambia el sitio hasta que alguien publica.
  publishedContent Json?     @map("published_content")
  publishedAt      DateTime? @map("published_at") @db.Timestamptz()

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections PageSection[]
  versions PageVersion[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("pages")
}

model PageSection {
  id       String  @id @default(uuid(7)) @db.Uuid
  pageId   String  @map("page_id") @db.Uuid
  type     String  @db.VarChar(100)
  position Int
  props    Json    @default("{}")
  anchor   String? @db.VarChar(100)
  /// Oculto: sigue en el borrador y en el panel, pero no sale al sitio publicado.
  isHidden Boolean @default(false) @map("is_hidden")
  page     Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, position])
  @@index([pageId])
  @@map("page_sections")
}

/// Foto del borrador de una página en un momento dado. Permite deshacer cualquier cambio,
/// venga de una persona o de un agente.
model PageVersion {
  id     String @id @default(uuid(7)) @db.Uuid
  pageId String @map("page_id") @db.Uuid

  /// Contenido completo: título, descripción y secciones con sus props.
  snapshot Json
  /// Qué pasó, en una línea: "Editó el bloque Hero", "Restauró la versión del 3 de marzo".
  summary  String @db.VarChar(255)

  actorType String  @map("actor_type") @db.VarChar(20)
  actorId   String? @map("actor_id") @db.Uuid
  actorName String  @map("actor_name") @db.VarChar(255)
  /// Marca la versión que corresponde a lo que está publicado ahora.
  published Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@map("page_versions")
}

model NavigationLink {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  label    String @db.VarChar(100)
  href     String @db.VarChar(255)
  position Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, position])
  @@index([tenantId])
  @@map("navigation_links")
}

/// Registro de cada archivo subido al bucket (MinIO en dev, Cloudflare R2 en
/// producción). El bucket es privado: `key` es lo único que se guarda en el
/// `props` JSONB de una `PageSection` o en un `GlobalSetting.value`, nunca una
/// URL — las URLs firmadas (presigned) se generan al vuelo en cada lectura,
/// así que nunca quedan expuestas ni expiran mientras están "guardadas".
model StorageAsset {
  id       String @id @default(uuid(7)) @db.Uuid
  key      String @unique @db.VarChar(500)
  mimeType String @map("mime_type") @db.VarChar(100)
  size     Int

  /// Nulo en los archivos subidos antes de que la biblioteca fuera por cliente.
  tenantId     String? @map("tenant_id") @db.Uuid
  /// Nombre con el que se subió, para poder buscarlo en el panel.
  originalName String? @map("original_name") @db.VarChar(255)
  /// Texto alternativo; sin él la imagen es invisible para un lector de pantalla.
  alt          String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("storage_assets")
}

/// Usuario del panel de administración. Un solo tipo de cuenta, sin scoping
/// por tenant: es una herramienta interna de la agencia para gestionar
/// todos sus clientes desde un mismo login, no un portal self-service para
/// que cada cliente entre a su propio sitio.
model AdminUser {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  /// `owner` gestiona usuarios y claves; `editor`, el contenido de todos los clientes;
  /// `client`, solo el de los suyos (ver `tenants`).
  role         String    @default("owner") @db.VarChar(20)
  /// Un usuario desactivado no entra y sus tokens dejan de valer.
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz()

  apiKeys        ApiKey[]
  passwordResets PasswordReset[]
  tenants        AdminUserTenant[]

  @@map("admin_users")
}

// Qué clientes alcanza una persona con rol `client`. Para `owner` y `editor` no hay filas:
// su alcance son todos los clientes.
model AdminUserTenant {
  adminUserId String    @map("admin_user_id") @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([adminUserId, tenantId])
  @@index([tenantId])
  @@map("admin_user_tenants")
}

/// Identidad de marca y estilo visual del tenant. Todo opcional: sin fila, valores por defecto.
model TenantBrand {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// Colores base en hex; los tonos derivados se calculan al renderizar, no se guardan.
  palette    Json @default("{}")
  /// `{ pairing, scale }`: id de una combinación curada y escala del texto.
  typography Json @default("{}")
  /// `keys` del bucket privado, nunca URLs: se firman al vuelo.
  assets     Json @default("{}")

  /// `light` | `dark` | `system`.
  colorMode   String @default("system") @map("color_mode") @db.VarChar(20)
  /// Id del estilo visual (Épica 2); `classic` es el aspecto actual.
  visualStyle String @default("classic") @map("visual_style") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_brands")
}

model GlobalSetting {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  key      String @db.VarChar(100)
  value    String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("global_settings")
}

/// Clave de acceso para agentes de IA y herramientas externas. Solo se guarda el hash.
model ApiKey {
  id   String @id @default(uuid(7)) @db.Uuid
  name String @db.VarChar(255)

  /// Parte visible de la clave, para identificarla en el listado sin poder usarla.
  prefix  String @unique @db.VarChar(24)
  /// SHA-256 de la clave completa. La clave en claro se muestra una sola vez, al crearla.
  keyHash String @map("key_hash") @db.VarChar(64)

  /// `read` | `write` | `full`. Solo `full` publica y elimina.
  permission         String  @db.VarChar(20)
  /// Falso = la clave solo alcanza los tenants listados en `tenants`.
  scopeAllTenants    Boolean @default(true) @map("scope_all_tenants")
  /// Techo de peticiones por minuto, para que un agente en bucle no tumbe la API.
  rateLimitPerMinute Int     @default(120) @map("rate_limit_per_minute")

  createdById String    @map("created_by_id") @db.Uuid
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz()
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz()
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  createdBy AdminUser      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tenants   ApiKeyTenant[]

  @@index([keyHash])
  @@map("api_keys")
}

/// Alcance de una clave limitada a ciertos clientes.
model ApiKeyTenant {
  apiKeyId String @map("api_key_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, tenantId])
  @@index([tenantId])
  @@map("api_key_tenants")
}

/// Quién cambió qué y cuándo. Persona o agente: el actor se identifica igual en ambos casos.
model ActivityLog {
  id String @id @default(uuid(7)) @db.Uuid

  /// Nulo en acciones que no son de un cliente concreto (crear un cliente, gestionar claves).
  tenantId String? @map("tenant_id") @db.Uuid

  /// `admin` | `apiKey`.
  actorType String  @map("actor_type") @db.VarChar(20)
  actorId   String? @map("actor_id") @db.Uuid
  /// Nombre legible congelado al momento del hecho: borrar la clave no borra su rastro.
  actorName String  @map("actor_name") @db.VarChar(255)

  /// Verbo del dominio, ej. `page.update`, `brand.update`, `apiKey.revoke`.
  action     String  @db.VarChar(100)
  entityType String  @map("entity_type") @db.VarChar(50)
  entityId   String? @map("entity_id") @db.VarChar(100)
  summary    String

  /// Estado antes y después, cuando la operación pudo capturarlo. Base del historial (Spec 9.4).
  before Json?
  after  Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([actorType, actorId])
  @@index([createdAt])
  @@map("activity_logs")
}

/// Mensaje del formulario de contacto. Se guarda ANTES de intentar el correo: si el SMTP
/// falla, el negocio igual no pierde el contacto.
model ContactMessage {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name    String  @db.VarChar(100)
  email   String  @db.VarChar(255)
  phone   String? @db.VarChar(20)
  message String

  /// Nulo mientras no se intentó enviar; con fecha si el correo salió.
  emailedAt  DateTime? @map("emailed_at") @db.Timestamptz()
  /// Motivo del último fallo de envío, para poder reintentar a mano.
  emailError String?   @map("email_error")

  readAt    DateTime? @map("read_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("contact_messages")
}

/// Entrada del blog. `status` es `draft` | `published` | `scheduled`; una `scheduled` se
/// vuelve visible sola cuando `publishedAt` llega, resuelto en la consulta del repositorio.
model BlogPost {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  slug     String @db.VarChar(255)
  title    String @db.VarChar(255)
  excerpt  String

  /// `key` del bucket privado, nunca una URL: se firma al vuelo en cada lectura.
  coverImageKey String? @map("cover_image_key") @db.VarChar(500)
  /// Bloques de contenido enriquecido, validados por `BlogContentSchema` (zod).
  content       Json    @default("[]")
  authorName    String  @map("author_name") @db.VarChar(255)

  status      String    @default("draft") @db.VarChar(20)
  publishedAt DateTime? @map("published_at") @db.Timestamptz()
  tags        String[]  @default([])

  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description")
  /// `key` del bucket privado para compartir en redes; misma regla que `coverImageKey`.
  ogImageKey     String? @map("og_image_key") @db.VarChar(500)
  /// Publicada pero fuera del índice: el enlace funciona, el buscador no la lista.
  noindex        Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt])
  @@map("blog_posts")
}

/// Correo suscrito a novedades desde el bloque de suscripción.
model NewsletterSubscriber {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  email    String @db.VarChar(255)

  /// Nulo si la persona se dio de baja; la fila se conserva para no volver a escribirle.
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz()
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz()

  /// Token de baja: va en el enlace de cada correo comercial, que el art. 28 B de la Ley
  /// 19.496 exige. Es estable (el mismo enlace sirve siempre) e imposible de adivinar, así
  /// que nadie puede dar de baja a otro probando correos.
  unsubscribeToken String   @unique @map("unsubscribe_token") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
  @@map("newsletter_subscribers")
}

/// Categoría del catálogo de un cliente.
model ProductCategory {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  slug     String @db.VarChar(255)
  name     String @db.VarChar(255)
  position Int    @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("product_categories")
}

/// Producto del catálogo. La etapa 1 vende por WhatsApp: no hay carrito ni pagos todavía.
model Product {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  slug     String @db.VarChar(255)
  name     String @db.VarChar(255)

  description String
  /// `keys` del bucket privado, nunca URLs: se firman al vuelo en cada lectura.
  imageKeys   String[] @default([]) @map("image_keys")

  /// Dinero en enteros, nunca en coma flotante: el error aparece tarde y en la factura.
  priceCents     Int    @map("price_cents")
  salePriceCents Int?   @map("sale_price_cents")
  currency       String @default("CLP") @db.VarChar(3)

  categoryId String? @map("category_id") @db.Uuid
  /// `[{ name: "Talla", options: ["S","M","L"] }]`.
  variants   Json    @default("[]")

  isActive Boolean @default(true) @map("is_active")
  featured Boolean @default(false)
  position Int     @default(0)

  /// `null` = no se controla stock. 0 = agotado.
  stock Int? @map("stock")

  /// Título y descripción para buscadores; nulos = se usan `name` y `description`.
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description")
  /// Activo pero fuera del índice: se puede comprar por el enlace, el buscador no lo lista.
  noindex        Boolean @default(false)

  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category  ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@index([tenantId, featured])
  @@map("products")
}

/// Enlace de un solo uso para recuperar la contraseña. Se guarda el hash, nunca el token.
model PasswordReset {
  id          String    @id @default(uuid(7)) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz()
  usedAt      DateTime? @map("used_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("password_resets")
}

// Configuración de la tienda de un cliente. Sin fila, el cliente no tiene tienda: nada
// relacionado con productos ni pedidos se muestra en su sitio (SPEC 8.4).
model StoreSettings {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  isEnabled Boolean @default(false) @map("is_enabled")
  currency  String  @default("CLP") @db.VarChar(3)

  /// En Chile los precios se muestran con IVA incluido; el desglose es informativo.
  taxIncluded    Boolean @default(true) @map("tax_included")
  taxRatePercent Int     @default(19) @map("tax_rate_percent")

  /// `[{ code, name, priceCents, estimate, requiresAddress }]`.
  shippingOptions            Json @default("[]") @map("shipping_options")
  freeShippingThresholdCents Int? @map("free_shipping_threshold_cents")

  /// `none` = solo pedido por WhatsApp (etapa 1).
  paymentProvider    String  @default("none") @map("payment_provider") @db.VarChar(20)
  /// Credenciales de la cuenta de cobro del propio cliente. Nunca sale de la API.
  paymentCredentials Json    @default("{}") @map("payment_credentials")
  notificationEmail  String? @map("notification_email") @db.VarChar(255)
  /// Página con los términos de compra. Si existe y está publicada, comprar exige aceptarlos.
  termsPageSlug      String? @map("terms_page_slug") @db.VarChar(255)

  /// Identificación del proveedor que exige el Reglamento de Comercio Electrónico. Sin estos
  /// datos completos la tienda no se puede encender (ver `sellerIsComplete`).
  legalName     String? @map("legal_name") @db.VarChar(255)
  /// RUT normalizado: sin puntos, con guion, K en mayúscula.
  taxId         String? @map("tax_id") @db.VarChar(20)
  sellerAddress String? @map("seller_address") @db.VarChar(255)
  sellerEmail   String? @map("seller_email") @db.VarChar(255)
  sellerPhone   String? @map("seller_phone") @db.VarChar(40)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

model Coupon {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String @db.VarChar(40)

  /// `percentage` descuenta `value`% del subtotal; `amount` descuenta `value` pesos.
  discountType String @map("discount_type") @db.VarChar(20)
  value        Int

  minimumCents Int?      @map("minimum_cents")
  startsAt     DateTime? @map("starts_at") @db.Timestamptz()
  endsAt       DateTime? @map("ends_at") @db.Timestamptz()
  maxUses      Int?      @map("max_uses")
  usedCount    Int       @default(0) @map("used_count")
  isActive     Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("coupons")
}

model Order {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// Número que ve el comprador, correlativo por cliente: "0001", "0002".
  number   String @db.VarChar(20)

  status String @default("pending") @db.VarChar(20)

  customerName  String  @map("customer_name") @db.VarChar(160)
  customerEmail String  @map("customer_email") @db.VarChar(255)
  customerPhone String  @map("customer_phone") @db.VarChar(40)
  /// RUT del comprador: obligatorio solo si pide factura, necesario para el documento
  /// tributario. Normalizado igual que el del vendedor.
  customerTaxId String? @map("customer_tax_id") @db.VarChar(20)

  /// Quién vendió, tal como estaba al confirmar la compra. Es una copia y no una referencia
  /// a propósito: si el cliente cambia su razón social mañana, el pedido de hoy tiene que
  /// seguir diciendo con quién se contrató.
  seller Json? @map("seller")

  /// `shipping` o `pickup`.
  deliveryMethod String  @map("delivery_method") @db.VarChar(20)
  addressLine    String? @map("address_line") @db.VarChar(255)
  addressCity    String? @map("address_city") @db.VarChar(120)
  addressRegion  String? @map("address_region") @db.VarChar(120)
  addressNotes   String? @map("address_notes")

  shippingCode  String? @map("shipping_code") @db.VarChar(40)
  shippingName  String? @map("shipping_name") @db.VarChar(120)
  shippingCents Int     @default(0) @map("shipping_cents")

  subtotalCents Int     @map("subtotal_cents")
  discountCents Int     @default(0) @map("discount_cents")
  totalCents    Int     @map("total_cents")
  taxCents      Int     @default(0) @map("tax_cents")
  currency      String  @default("CLP") @db.VarChar(3)
  couponCode    String? @map("coupon_code") @db.VarChar(40)

  /// Constancia de que el comprador aceptó los términos de compra: cuándo y qué versión
  /// (la fecha de publicación de la página de términos vigente en ese momento).
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz()
  termsVersion    String?   @map("terms_version") @db.VarChar(40)

  /// Constancia del correo de confirmación, que la Ley 19.496 exige mandar. Mismo criterio
  /// que `ContactMessage`: con fecha si salió, con motivo si falló, para poder reintentar.
  confirmationEmailedAt  DateTime? @map("confirmation_emailed_at") @db.Timestamptz()
  confirmationEmailError String?   @map("confirmation_email_error")

  paymentProvider  String?   @map("payment_provider") @db.VarChar(20)
  paymentReference String?   @map("payment_reference") @db.VarChar(255)
  paidAt           DateTime? @map("paid_at") @db.Timestamptz()

  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid(7)) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  /// `null` si el producto se borró después: el pedido conserva lo que se compró.
  productId String? @map("product_id") @db.Uuid
  name      String  @db.VarChar(255)
  /// `{ "Talla": "M", "Color": "Azul" }`.
  variant   Json    @default("{}")

  unitPriceCents Int @map("unit_price_cents")
  quantity       Int
  totalCents     Int @map("total_cents")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

// Una compra repetida con la misma clave (doble clic, reintento de red) devuelve el resultado
// de la primera en vez de crear otro pedido. Por cliente: la clave de uno no choca con otro.
model IdempotencyKey {
  id          String @id @default(uuid(7)) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  key         String @db.VarChar(255)
  // Operación a la que pertenece, para que la misma clave no se cruce entre endpoints.
  scope       String @db.VarChar(60)
  // sha256 del cuerpo: la misma clave con otro cuerpo es un error del cliente, no un reintento.
  requestHash String @map("request_hash") @db.VarChar(64)

  // `processing` mientras corre la primera; `completed` con la respuesta ya guardada.
  status         String @default("processing") @db.VarChar(20)
  responseStatus Int?   @map("response_status")
  responseBody   Json?  @map("response_body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Solicitud de un titular para ejercer sus derechos sobre sus datos (Ley 21.719). Se guarda
/// para poder acreditar que se respondió, y dentro de plazo: la ley da un mes y la carga de
/// la prueba es del responsable.
model DataRightsRequest {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// `acceso` | `rectificacion` | `cancelacion` | `oposicion` | `portabilidad`.
  right   String @db.VarChar(20)
  email   String @db.VarChar(255)
  /// Qué pide corregir, en una rectificación.
  details String @default("")

  /// `pendiente` | `verificada` | `resuelta` | `rechazada`.
  status String @default("pendiente") @db.VarChar(20)

  /// Hash del token que se manda por correo, nunca el token: quien lea la base no puede
  /// verificarse haciéndose pasar por el titular.
  verificationTokenHash String    @map("verification_token_hash") @db.VarChar(64)
  verificationExpiresAt DateTime  @map("verification_expires_at") @db.Timestamptz()
  verifiedAt            DateTime? @map("verified_at") @db.Timestamptz()
  resolvedAt            DateTime? @map("resolved_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([verificationTokenHash])
  @@map("data_rights_requests")
}

/// Redirección de una ruta vieja a una nueva. Se crea sola al cambiar el slug de una página,
/// una publicación o un producto: sin ella, la URL que Google indexó y la que alguien
/// compartió pasan a 404 y se pierde el posicionamiento acumulado.
model Redirect {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Ruta de origen, siempre con barra inicial y sin barra final: `/servicios-antiguos`.
  fromPath String @map("from_path") @db.VarChar(512)
  toPath   String @map("to_path") @db.VarChar(512)

  /// 301 (permanente) o 302 (temporal). Un cambio de slug es siempre permanente.
  statusCode Int @default(301) @map("status_code")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromPath])
  @@index([tenantId])
  @@map("redirects")
}

/// Registro de consentimiento. Es la prueba que la Ley 21.719 le exige al responsable poder
/// mostrar: quién aceptó, qué aceptó, cuándo y sobre qué texto. Es INMUTABLE — cambiar de
/// opinión crea una fila nueva, nunca edita la anterior — porque un registro que se puede
/// reescribir no prueba nada.
model ConsentRecord {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Quién: un identificador que el navegador guarda, o el hash del correo cuando el
  /// consentimiento llega desde un formulario.
  subject     String   @db.VarChar(128)
  /// De dónde vino: `cookies`, `contact` o `newsletter`.
  source      String   @db.VarChar(20)
  /// Qué aceptó. Vacío = rechazó todo lo que era opcional.
  purposes    String[] @default([])
  /// Sobre qué texto. Si el texto legal cambia, el consentimiento anterior deja de valer.
  textVersion String   @map("text_version") @db.VarChar(40)

  /// Huella de la IP, nunca la IP: acredita el origen sin guardar un dato personal que no
  /// hace falta conservar.
  ipHash    String? @map("ip_hash") @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, subject, createdAt])
  @@index([tenantId, createdAt])
  @@map("consent_records")
}

/// Retracto o reclamo de un comprador. La Ley 19.496 pide que revertir la compra sea tan
/// simple como hacerla y que exista un canal de reclamos con respuesta en plazo; se guardan
/// para poder acreditar que se respondió y cuándo.
model ConsumerClaim {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// `retracto` | `reclamo`.
  kind   String @db.VarChar(20)
  /// `pendiente` | `aceptado` | `rechazado`.
  status String @default("pendiente") @db.VarChar(20)

  /// Número de pedido tal como lo ve el comprador; nulo en un reclamo sin compra asociada.
  orderNumber String? @map("order_number") @db.VarChar(20)
  email       String  @db.VarChar(255)
  message     String  @default("")

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@map("consumer_claims")
}

/// Enlace de revisión compartible para que el cliente vea el sitio en borrador antes de publicar.
/// Se guarda el hash del token, nunca el token en claro, por seguridad.
model PreviewLink {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// SHA-256 del token aleatorio entregado al usuario.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  /// Fecha en la que el enlace fue anulado manualmente. Nulo si sigue vigente (salvo que expire).
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, expiresAt])
  @@map("preview_links")
}

/// Suscripción de la agencia cobrada al cliente por tener el sitio.
model Subscription {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @unique @map("tenant_id") @db.Uuid
  planName   String   @map("plan_name") @db.VarChar(100)
  priceCents Int      @map("price_cents")
  startsAt   DateTime @map("starts_at") @db.Timestamptz()
  /// Día del mes en que se cobra (1 a 31).
  billingDay Int      @map("billing_day")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments SubscriptionPayment[]

  @@map("subscriptions")
}

/// Pago de una suscripción de agencia.
model SubscriptionPayment {
  id             String @id @default(uuid(7)) @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid

  amountCents   Int      @map("amount_cents")
  /// Fecha en que se recibió el pago.
  paidAt        DateTime @map("paid_at") @db.Timestamptz()
  /// Medio por el cual se pagó (ej. transferencia, tarjeta).
  paymentMethod String   @map("payment_method") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, paidAt])
  @@map("subscription_payments")
}

/// Registro de firma de documentos contractuales (servicio, datos, etc.).
/// Es INMUTABLE: cada firma es un hecho aislado. Si se firma una nueva versión,
/// se inserta un nuevo registro.
model SignedDocument {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// El tipo de documento firmado, e.g. "contrato-de-servicio"
  document String @db.VarChar(100)
  /// La versión que se firmó, e.g. "v1.0"
  version  String @db.VarChar(40)
  /// Quién lo firmó en representación del cliente (RUT, nombre o email)
  signedBy String @map("signed_by") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, document])
  @@index([document, version])
  @@map("signed_documents")
}

/// Negocio al que la agencia le arma una demo antes de llamarlo. Son datos personales (quién
/// atiende, su teléfono, su correo): se borran junto con sus demos.
model Prospect {
  id           String  @id @default(uuid(7)) @db.Uuid
  businessName String  @map("business_name") @db.VarChar(255)
  contactName  String? @map("contact_name") @db.VarChar(160)
  phone        String? @db.VarChar(40)
  email        String? @db.VarChar(255)
  /// Rubro, en palabras de quien lo cargó ("pastelería").
  industry     String? @db.VarChar(120)
  /// De dónde salió: "Google Maps", "Instagram", "referido"...
  source       String? @db.VarChar(120)
  notes        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  demos     Demo[]

  @@map("prospects")
}

/// Sitio privado de un prospecto: un tenant en estado `demo` más lo que hace falta para
/// venderlo. La fila está pensada para sobrevivir al borrado del sitio como registro anónimo
/// para métricas: por eso el tenant y el prospecto se sueltan (SetNull) en vez de arrastrarla,
/// y el kit, el rubro y quién la creó son copias y no referencias.
model Demo {
  id         String  @id @default(uuid(7)) @db.Uuid
  /// Una demo por tenant. Nulo cuando el sitio ya se borró.
  tenantId   String? @unique @map("tenant_id") @db.Uuid
  prospectId String? @map("prospect_id") @db.Uuid

  /// Kit de origen, si nació de uno.
  templateId String? @map("template_id") @db.VarChar(100)
  /// Copia del rubro al crearla: la ficha del prospecto se borra, la métrica no.
  industry   String? @db.VarChar(120)

  /// Quién la creó, congelado como en `ActivityLog`: `admin` | `apiKey`.
  actorType String  @map("actor_type") @db.VarChar(20)
  actorId   String? @map("actor_id") @db.Uuid
  actorName String  @map("actor_name") @db.VarChar(255)

  /// Nulo = sin vencimiento (ej. una demo que se usa de portafolio).
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz()
  /// Nulo mientras no haya resultado; `converted` | `discarded`.
  outcome        String?   @db.VarChar(20)
  outcomeAt      DateTime? @map("outcome_at") @db.Timestamptz()
  /// Por qué se descartó, de una lista cerrada: `no-interesado`, `precio`, `ya-tiene-sitio`,
  /// `no-responde`, `otro`, u `otra-propuesta` si se convirtió otra demo del mismo prospecto.
  /// Sin texto libre, así que se conserva en la fila anónima para las métricas.
  discardReason  String?   @map("discard_reason") @db.VarChar(1000)
  /// Cuántas veces se extendió; cada extensión suma `DEMO_DURATION_DAYS`.
  extensionCount Int       @default(0) @map("extension_count")

  /// Aviso de vencimiento al prospecto: cuándo salió y para qué vencimiento. Si la demo se
  /// extiende, `expiryWarningFor` deja de coincidir con `expiresAt` y el aviso vuelve a correr.
  expiryWarningSentAt DateTime? @map("expiry_warning_sent_at") @db.Timestamptz()
  expiryWarningFor    DateTime? @map("expiry_warning_for") @db.Timestamptz()
  /// Por qué falló el último intento; se limpia cuando sale. La tarea siguiente lo reintenta.
  expiryWarningError  String?   @map("expiry_warning_error")

  /// Contadores propios: se conservan aunque las visitas se borren con los datos personales.
  visitCount   Int       @default(0) @map("visit_count")
  firstVisitAt DateTime? @map("first_visit_at") @db.Timestamptz()
  lastVisitAt  DateTime? @map("last_visit_at") @db.Timestamptz()

  /// Cuándo se borró el sitio y los datos personales; la fila queda como rastro anónimo.
  purgedAt DateTime? @map("purged_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  prospect     Prospect?         @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  accessTokens DemoAccessToken[]
  visits       DemoVisit[]
  pendingFiles DemoPendingFile[]

  @@index([prospectId])
  @@index([actorId])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("demos")
}

/// Enlace mágico de una demo. `prospect` vale mientras la demo esté vigente y registra
/// visitas; `team` vale mientras la demo exista y no registra nada. Se guarda el hash del
/// token, nunca el token.
model DemoAccessToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  demoId    String    @map("demo_id") @db.Uuid
  kind      String    @db.VarChar(20)
  /// SHA-256 del token entregado.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  /// Regenerar anula el anterior al instante.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  demo      Demo      @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId, kind])
  @@map("demo_access_tokens")
}

/// Archivo del bucket de una demo borrada que todavía falta borrar. Se anota en la misma
/// transacción que borra el sitio (la biblioteca del tenant se va con él y con ella la lista
/// de sus archivos), y la tarea diaria lo reintenta hasta que sale.
model DemoPendingFile {
  id            String    @id @default(uuid(7)) @db.Uuid
  demoId        String    @map("demo_id") @db.Uuid
  key           String    @unique @db.VarChar(500)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  demo          Demo      @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId])
  @@map("demo_pending_files")
}

/// Página que el prospecto abrió con su enlace. Es un dato personal del prospecto: se borra
/// con la demo, y los contadores de `Demo` quedan.
model DemoVisit {
  id        String   @id @default(uuid(7)) @db.Uuid
  demoId    String   @map("demo_id") @db.Uuid
  pageSlug  String   @map("page_slug") @db.VarChar(255)
  /// Huella de la IP con el mismo criterio que el consentimiento; nunca la IP.
  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  visitedAt DateTime @default(now()) @map("visited_at") @db.Timestamptz()
  demo      Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@index([demoId, visitedAt])
  @@map("demo_visits")
}
